# Copy to .env and fill in. Never commit .env.
# Do not create .env.local: Next.js loads it over .env. Pull Vercel vars with `vercel env pull .env.vercel`.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Google sign-in (interim until the Slack app exists — open-questions #41)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ORGANIZER_EMAILS=cmerrill@jahnelgroup.com   # comma-separated
ALLOWED_EMAIL_DOMAINS=jahnelgroup.com        # who may sign in with Google

# Slack sign-in turns on automatically once both are set
AUTH_SLACK_ID=
AUTH_SLACK_SECRET=

# Slack bot
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=        # channel ID for #108state
ORGANIZER_SLACK_IDS=     # Chelsea's Slack user ID. Local dev: SEED_CHELSEA_MERRILL (the seed organizer), plus your real ID once Slack sign-in works

# Vercel Cron
CRON_SECRET=

APP_URL=http://localhost:3000

# Local dev only: lets `npm run db:seed` write sample data. Never set in production.
ALLOW_SEED=true
