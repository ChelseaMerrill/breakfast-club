# Copy to .env and fill in. Never commit .env.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_SLACK_ID=
AUTH_SLACK_SECRET=

# Slack bot
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=        # channel ID for #108state
ORGANIZER_SLACK_IDS=     # Chelsea's Slack user ID

# Vercel Cron
CRON_SECRET=

APP_URL=http://localhost:3000

# Local dev only: lets `npm run db:seed` write sample data. Never set in production.
ALLOW_SEED=true
