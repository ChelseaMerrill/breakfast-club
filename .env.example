# Copy to .env and fill in. Never commit .env.
# Do not create .env.local: Next.js loads it over .env. Pull Vercel vars with `vercel env pull .env.vercel`.

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Sign in with Slack (the only sign-in) turns on once both are set
AUTH_SLACK_ID=
AUTH_SLACK_SECRET=

# Slack bot
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=        # channel ID for #108state
ORGANIZER_SLACK_IDS=     # Chelsea's Slack user ID. Local dev: SEED_CHELSEA_MERRILL (the seed organizer), plus your real ID once Slack sign-in works

# Optional: Slack Web API base URL (default https://slack.com/api). Local e2e points this at
# the fake Slack in e2e/fake-slack.ts, e.g. http://127.0.0.1:3901/api with SLACK_BOT_TOKEN=xoxb-test-fake
SLACK_API_BASE=

# Vercel Cron (Authorization: Bearer $CRON_SECRET). Generate with: openssl rand -hex 24
CRON_SECRET=

APP_URL=http://localhost:3000

# Local dev only: lets `npm run db:seed` write sample data. Never set in production.
ALLOW_SEED=true
